{
  "name": "ustam",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Ustam — the freelance marketplace of services in Tashkent: real masters, honest prices, chat, maps and a cabinet for masters.",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently -n web,api -c yellow,cyan \"npm run dev\" \"npm run server\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "sql": "node scripts/build_sql.mjs",
    "test": "node --test tests/shared.test.js && node --experimental-strip-types --no-warnings --test tests/domain.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
